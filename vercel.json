{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "crons": [
    { "path": "/api/v1/notifications/flush", "schedule": "*/10 * * * *" },
    { "path": "/api/v1/audit/purge", "schedule": "0 0 * * *" },
    { "path": "/api/v1/backup/run", "schedule": "30 2 * * *" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
