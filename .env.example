# server environment — copy to .env and fill in real values (never commit .env)

# Postgres connection string (Supabase / self-hosted)
DATABASE_URL=postgres://user:password@host:5432/myhr

# Server port
PORT=4010

# Email notifications (SMTP). Optional: if unset, configure SMTP in Admin Panel > Email Notifications.
# If set, these environment values OVERRIDE the stored Admin Panel settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-mail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-mail@gmail.com

# Secret for Vercel Cron endpoints (/api/v1/notifications/flush, /api/v1/audit/purge,
# /api/v1/backup/run). Vercel sends it automatically for cron calls; without it those
# endpoints reject.
CRON_SECRET=change-me

# Daily off-site backups -> Supabase Storage (private bucket).
# Create a private bucket named BACKUP_BUCKET once in the Supabase dashboard.
# SUPABASE_URL is your project URL (https://<ref>.supabase.co), NOT the DB host.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BACKUP_BUCKET=myhr-backups

# Biometric punch webhook: leave unset to REQUIRE a valid x-api-key (recommended).
# Set to 1 only to allow keyless devices to post punches (legacy escape hatch).
# ALLOW_OPEN_PUNCH=1

# Public app URL used in email links (defaults to the Vercel production URL)
APP_URL=https://myhr-by-swaniki.vercel.app

# REQUIRED in production — long random secrets. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of allowed browser origins. Leave blank in development
# (allows all). In production set your app domain(s), e.g.:
#   CORS_ORIGINS=https://myhr.example.com
CORS_ORIGINS=

# Partner hardware gateway API key
ANUBHAV_API_KEY=ANUBHAV_DNH_SECRET_2026
