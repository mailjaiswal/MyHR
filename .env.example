# server environment — copy to .env and fill in real values (never commit .env)

# Postgres connection string (Supabase / self-hosted)
DATABASE_URL=postgres://user:password@host:5432/myhr

# Server port
PORT=4010

# REQUIRED in production — long random secrets. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of allowed browser origins. Leave blank in development
# (allows all). In production set your app domain(s), e.g.:
#   CORS_ORIGINS=https://myhr.example.com
CORS_ORIGINS=

# Partner hardware gateway API key
ANUBHAV_API_KEY=ANUBHAV_DNH_SECRET_2026
